<!--
    Layout of the HelpdeskToolkit window. It only describes how the window looks;
    what the buttons do is wired up in Show-PCHealthCheck. Controls that the code
    needs carry an x:Name.

    Structure: a header with the options and the Run button, a list of pages on the
    left, and on the right the selected page: the results as cards, the Live monitor
    or the settings.

    Two things are changed by New-HealthCheckWindow before the window is created:
    - Colors: every color is a named brush below. For the dark theme the colors of
      these brushes are replaced with the ones in Assets\DarkTheme.psd1.
    - Language: every text written here (Text, Content, ToolTip) is looked up in the
      translation table of the chosen language.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpdeskToolkit - PC Health Check"
        Width="1180" Height="860" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Light theme; the same colors as the HTML report. The layout refers to these
             brushes with DynamicResource, never StaticResource: the theme is changed
             while the window is open by putting other brushes under the same names
             (see Set-WindowTheme). -->
        <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F8"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#14233A"/>
        <SolidColorBrush x:Key="HeaderMutedBrush" Color="#B3C0D3"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE3EA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#18212F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5A6677"/>
        <SolidColorBrush x:Key="NeutralBrush" Color="#C3CCD8"/>
        <SolidColorBrush x:Key="OkBrush" Color="#1B7A48"/>
        <SolidColorBrush x:Key="OkBackBrush" Color="#E4F4EA"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00"/>
        <SolidColorBrush x:Key="WarningBackBrush" Color="#FFF3D1"/>
        <SolidColorBrush x:Key="WarningDotBrush" Color="#D48A00"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="#B3261E"/>
        <SolidColorBrush x:Key="CriticalBackBrush" Color="#FDE7E5"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#2B5EA8"/>
        <SolidColorBrush x:Key="InfoBackBrush" Color="#E7EFFA"/>

        <!-- Controls -->
        <SolidColorBrush x:Key="HoverBrush" Color="#EEF2F7"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#DCE7F7"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#C5CEDA"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#E3E8EF"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CCD8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2B5EA8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A70BF"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#234E8C"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B7DDD"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5290EA"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2B67C0"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
        <!-- The veil over the window while the question at the start is open -->
        <SolidColorBrush x:Key="OverlayBrush" Color="#99101822"/>

        <!-- Live monitor: one color per component, used for its tile, meter and graph -->
        <SolidColorBrush x:Key="CpuBrush" Color="#2B5EA8"/>
        <SolidColorBrush x:Key="MemoryBrush" Color="#7A4FBF"/>
        <SolidColorBrush x:Key="GpuBrush" Color="#178F7E"/>
        <SolidColorBrush x:Key="DiskBrush" Color="#B8660E"/>
        <SolidColorBrush x:Key="GraphBackBrush" Color="#F6F8FB"/>
        <SolidColorBrush x:Key="GraphCaptionBrush" Color="#8A95A5"/>

        <!-- Buttons: rounded corners, a color change under the mouse and an optional icon.
             The icon is one character of the "Segoe MDL2 Assets" font, which is part of
             Windows 10 and 11; a button passes it in its Tag. The three styles below only
             differ in their colors. -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                    <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                               FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Ordinary button: the color of the surface with a thin border -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The main action of the side bar: filled with the accent color -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The Run button on the dark header: a brighter blue, without a border -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A small button inside a card or a tool bar -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- A button that looks like an entry of the page list: no border, text on the left -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <!-- The switch between the light and the dark theme in the header: a sun or a
             moon, and a track with a thumb that sits on the right while the dark theme
             is on -->
        <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Icon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="{DynamicResource HeaderMutedBrush}" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource OnAccentBrush}" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE708;"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource OnAccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The warning triangle on a tile of the Live monitor; a click opens the advice -->
        <Style x:Key="WarningToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="4,2">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource CriticalBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CriticalBackBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CriticalBackBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Show 5 more": a line of text with an arrow that opens and closes a list -->
        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field with rounded corners, in the colors of the theme -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scroll bars without arrow buttons. The two invisible buttons above and
             below the thumb make a click on the empty track scroll by one page. -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1,4,1,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="TileCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <!-- A slim, rounded bar. Used for the progress of a run and for the meters of the
             Live monitor page. PART_Track and PART_Indicator are the names WPF looks for
             to size the filled part itself. -->
        <Style x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The bar that fills while a check runs: the same shape with a color gradient. -->
        <Style x:Key="RunProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B7DDD" Offset="0"/>
                        <GradientStop Color="#35B6A6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MonitorTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- A tile that opens the detail page of its component when it is clicked -->
        <Style x:Key="MonitorTileLink" TargetType="Border" BasedOn="{StaticResource MonitorTile}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorTileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="MonitorTileSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- The frame around a history graph. The graph itself is a line drawn by
             Show-WindowMonitor into the Canvas inside the frame. -->
        <Style x:Key="GraphCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource GraphCaptionBrush}"/>
            <Setter Property="Margin" Value="6,3,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="GraphFrame" TargetType="Border">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Background" Value="{DynamicResource GraphBackBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- A row of a list whose entries can be clicked (the programs of the Live monitor) -->
        <Style x:Key="ClickableRow" TargetType="DockPanel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One entry of the page list on the left, laid out like the navigation of Windows
             11: an icon, the name, and on the right the number of problems. The selected
             entry gets a tinted background and a short bar of the accent color on its
             left edge. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="NavBackground" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="NavIndicator" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource InfoBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="NavIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The heading of a group in the side bar ("CHECKS", "REPORT") -->
        <Style x:Key="NavHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="10,12,0,4"/>
        </Style>

        <!-- A button of the side bar that looks like an entry of the page list: the icon in
             the same column, the text where the names of the pages begin. The icon is a
             character of "Segoe MDL2 Assets", passed in the Tag. -->
        <Style x:Key="NavActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The head of a column of results: the name of the status and how many results it has -->
        <Style x:Key="ColumnHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1,4,1,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- The clickable upper part of a compact result card: name and value, with an arrow
             that shows whether the details below are open -->
        <Style x:Key="CardToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="12,9,8,9">
                            <DockPanel>
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="6,4,0,0"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A result as a compact card, for the narrow columns of a category page. Closed
             it shows the name of the check and the start of its value; a click opens the
             whole value, the rest of a long list, the allowed range, the explanation and
             the recommendation with its button. -->
        <DataTemplate x:Key="CompactCard">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Highlight}" Value="Yes">
                                <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ToggleButton x:Name="CardToggle" IsChecked="{Binding Expanded, Mode=OneWay}" Style="{StaticResource CardToggle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Check}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- Closed, a long value is cut after three lines -->
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                <Setter Property="MaxHeight" Value="52"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel Margin="12,0,12,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CardToggle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding More}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding More}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Reference}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reference}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Description}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Why the problem matters: what it leads to when it stays -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Risk}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>                        <Border CornerRadius="5" Padding="9,7" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource InfoBackBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                            <Setter Property="Background" Value="{DynamicResource WarningBackBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Critical">
                                            <Setter Property="Background" Value="{DynamicResource CriticalBackBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Recommendation}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding RecommendationLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <Button Content="{Binding ActionLabel}" Tag="&#xE8A7;" HorizontalAlignment="Left" Margin="0,8,0,1">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One section of a detail page of the Live monitor: a title and lines of a name
             and a value. A line can carry a meter in front of its value. -->
        <DataTemplate x:Key="DetailSection">
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Width="170" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Meter}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Background>
        <DynamicResource ResourceKey="WindowBrush"/>
    </Window.Background>

    <Grid>
    <DockPanel x:Name="MainLayout">

        <!-- Header: title on the left, options and the Run button on the right -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="HELPDESKTOOLKIT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HeaderMutedBrush}"/>
                    <TextBlock Text="PC Health Check" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="ComputerText" Foreground="{DynamicResource HeaderMutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeSwitch}" ToolTip="Switch to the dark theme (Ctrl+T)" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <CheckBox x:Name="SkipNetworkCheckBox" Content="Skip network tests" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="History period" Foreground="{DynamicResource HeaderMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DaysComboBox" Width="92" VerticalAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="7 days" Tag="7"/>
                        <ComboBoxItem Content="14 days" Tag="14"/>
                        <ComboBoxItem Content="30 days" Tag="30"/>
                        <ComboBoxItem Content="90 days" Tag="90"/>
                    </ComboBox>
                    <Button x:Name="RunButton" Content="Run check" Tag="&#xE768;" ToolTip="Run all checks (F5)" Style="{StaticResource PrimaryButton}" Margin="18,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Progress of a running check: what is being checked, which step, how far.
             Only visible while a check runs. -->
        <Border x:Name="RunPanel" DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12,20,14" Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="RunPercent" DockPanel.Dock="Right" Text="0 %" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                    <TextBlock x:Name="RunStep" DockPanel.Dock="Right" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,16,0"/>
                    <TextBlock x:Name="RunTitle" Text="Starting the check ..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </DockPanel>
                <ProgressBar x:Name="ProgressBar" Style="{StaticResource RunProgressBar}"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,7">
            <TextBlock x:Name="StatusText" Text="Ready. Click Run check to examine this computer." Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: the pages and the report, then the rights and the settings at the bottom -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8,10,8,8">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="-8,8,-8,0" Padding="8,6,8,0">
                        <StackPanel>
                            <!-- Whether the window runs with administrator rights: without them
                                 a button offers the restart, with them a line says so. -->
                            <Button x:Name="ElevateButton" Content="Restart as administrator" Tag="&#xEA18;" ToolTip="Standard rights: some checks are skipped." Style="{StaticResource NavActionButton}"/>
                            <DockPanel x:Name="ElevationPanel" Margin="10,4,4,4" Visibility="Collapsed">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Top" Margin="0,2,17,0"/>
                                <TextBlock x:Name="ElevationText" Text="Standard rights: some checks are skipped." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </DockPanel>
                            <Button x:Name="SettingsButton" Content="Settings" Tag="&#xE713;" ToolTip="Language, theme and the automatic check (Ctrl+,)" Style="{StaticResource NavActionButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Pages and report scroll together when the window is too low for all
                         of them, so the pages always come first. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <!-- The pages of the application, then the check categories under their
                                 own heading (the entries carry the name of their group). -->
                            <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <!-- Without the frame of the standard list, which turns grey when
                                     the window is disabled behind the question at the start -->
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <StackPanel>
                                                                <ContentPresenter/>
                                                                <ItemsPresenter/>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="GroupTitle" Text="{Binding Name}" Style="{StaticResource NavHeader}"/>
                                                <DataTemplate.Triggers>
                                                    <!-- The first group, the pages, has no heading -->
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter TargetName="GroupTitle" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NavIcon" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NavLabel" Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <!-- Number of problems in the category, in the color of the
                                                 worst one; hidden when there are none -->
                                            <Border Grid.Column="2" CornerRadius="9" Padding="7,1" MinWidth="22" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBackBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Worst}" Value="Critical">
                                                                <Setter Property="Background" Value="{DynamicResource CriticalBackBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Badge}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Worst}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                <Setter TargetName="NavLabel" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="REPORT" Style="{StaticResource NavHeader}"/>
                            <Button x:Name="OpenReportButton" Content="Open HTML report" Tag="&#xE8A7;" ToolTip="Save the report and open it in the browser (Ctrl+O)" Style="{StaticResource NavActionButton}" IsEnabled="False"/>
                            <Button x:Name="CopySummaryButton" Content="Copy summary" Tag="&#xE8C8;" ToolTip="Copy the problems as text for a ticket or an e-mail (Ctrl+Shift+C)" Style="{StaticResource NavActionButton}" IsEnabled="False"/>
                            <Button x:Name="SaveAsButton" Content="Save as..." Tag="&#xE74E;" ToolTip="Save the report as HTML, PDF, JSON or CSV (Ctrl+S)" Style="{StaticResource NavActionButton}" IsEnabled="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right: the selected page -->
            <Grid Grid.Column="1" Margin="20,16,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Problems that an automatic check has found. A click on one of them opens
                     its result. Shown on every page until it is dismissed. -->
                <Border x:Name="NoticeBorder" Grid.Row="0" Background="{DynamicResource WarningBackBrush}" BorderBrush="{DynamicResource WarningDotBrush}" BorderThickness="4,0,0,0" CornerRadius="6" Padding="14,9,8,9" Margin="0,0,6,12" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="NoticeCloseButton" DockPanel.Dock="Right" Tag="&#xE711;" ToolTip="Dismiss" Style="{StaticResource NavButton}" Padding="8,5,0,5" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock x:Name="NoticeTitle" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="NoticeItems" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Style="{StaticResource ClickableRow}" Margin="0,1,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Link}" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" Margin="12,2,4,2"/>
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Title of the page; on pages with results also the search field and the status filter -->
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <StackPanel x:Name="FilterPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,6,0" Visibility="Collapsed">
                        <Grid Width="220">
                            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" ToolTip="Search all results (Ctrl+F)"/>
                            <TextBlock x:Name="SearchHint" Text="Search all results ..." Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <ComboBox x:Name="StatusFilter" Width="140" Margin="8,0,0,0" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="All statuses" Tag=""/>
                            <ComboBoxItem Content="Problems only" Tag="Problems"/>
                            <ComboBoxItem Content="Critical" Tag="Critical"/>
                            <ComboBoxItem Content="Warning" Tag="Warning"/>
                            <ComboBoxItem Content="OK" Tag="OK"/>
                            <ComboBoxItem Content="Info" Tag="Info"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="PageSubtitle" Text="Click Run check to examine this computer." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <!-- Shown on the Overview page only: verdict, score and count per status,
                     and what changed since the last check -->
                <StackPanel x:Name="OverviewPanel" Grid.Row="2">
                    <Border x:Name="VerdictBorder" CornerRadius="6" Padding="14,9" Margin="0,0,0,12" BorderThickness="4,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="VerdictText" FontSize="14" TextWrapping="Wrap"/>
                    </Border>
                    <UniformGrid Columns="5" Margin="0,0,-10,14">
                        <Border x:Name="ScoreBorder" Style="{StaticResource Tile}" BorderBrush="{DynamicResource NeutralBrush}"
                                ToolTip="100 minus 15 points for every critical result and 4 for every warning">
                            <StackPanel>
                                <TextBlock x:Name="ScoreCount" Text="-" Style="{StaticResource TileCount}" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="HEALTH SCORE" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" BorderBrush="{DynamicResource CriticalBrush}">
                            <StackPanel>
                                <TextBlock x:Name="CriticalCount" Text="-" Style="{StaticResource TileCount}" Foreground="{DynamicResource CriticalBrush}"/>
                                <TextBlock Text="CRITICAL" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" BorderBrush="{DynamicResource WarningBrush}">
                            <StackPanel>
                                <TextBlock x:Name="WarningCount" Text="-" Style="{StaticResource TileCount}" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="WARNING" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" BorderBrush="{DynamicResource OkBrush}">
                            <StackPanel>
                                <TextBlock x:Name="OkCount" Text="-" Style="{StaticResource TileCount}" Foreground="{DynamicResource OkBrush}"/>
                                <TextBlock Text="OK" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" BorderBrush="{DynamicResource InfoBrush}">
                            <StackPanel>
                                <TextBlock x:Name="InfoCount" Text="-" Style="{StaticResource TileCount}" Foreground="{DynamicResource InfoBrush}"/>
                                <TextBlock Text="INFO" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Where the points of the score went, for example "Points lost: Security -19" -->
                    <TextBlock x:Name="ScoreDetailText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,-6,6,12" Visibility="Collapsed"/>

                    <!-- What changed since the previous check of this computer -->
                    <Border x:Name="ChangesBorder" Style="{StaticResource SectionCard}" Margin="0,0,6,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ChangesTitle" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="ChangesItems" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <Border DockPanel.Dock="Left" CornerRadius="9" Padding="9,1" Margin="0,0,10,0" MinWidth="96" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource OkBackBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Worse">
                                                                <Setter Property="Background" Value="{DynamicResource CriticalBackBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Change}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Worse">
                                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Transition}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- The results of the page, one card per check -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ResultItems" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Highlight}" Value="Yes">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status badge -->
                                            <Border Grid.Column="0" CornerRadius="9" Padding="9,1" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource InfoBackBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="OK">
                                                                <Setter Property="Background" Value="{DynamicResource OkBackBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBackBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                                <Setter Property="Background" Value="{DynamicResource CriticalBackBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="OK">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <!-- Check name, with the category where cards of several categories are mixed -->
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Check}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                </DockPanel>

                                                <!-- What was found -->
                                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>

                                                <!-- The rest of a long list, opened on click -->
                                                <StackPanel Margin="0,4,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding More}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ToggleButton x:Name="MoreToggle" Content="{Binding MoreHeader}" Style="{StaticResource LinkToggle}"/>
                                                    <TextBlock Text="{Binding More}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="16,4,0,2">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=MoreToggle}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Allowed range and typical value of a measurement -->
                                                <TextBlock Text="{Binding Reference}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Reference}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- What the checked thing is -->
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Why the problem matters: what it leads to when it stays -->
                                                <StackPanel Margin="0,8,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Risk}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- What to do about it, with a button that opens the place in
                                                     Windows where it is done -->
                                                <Border CornerRadius="5" Padding="10,7" Margin="0,8,0,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource InfoBackBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningBackBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                                    <Setter Property="Background" Value="{DynamicResource CriticalBackBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Recommendation}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RecommendationLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <Button Content="{Binding ActionLabel}" Tag="&#xE8A7;" HorizontalAlignment="Left" Margin="0,8,0,1">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ActionLabel}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- The page of a category: its results side by side, one column per status,
                         from Info on the left to Critical on the right. Every column scrolls on its own, so its
                         head stays in view. A column that a status filter excludes is hidden
                         and the others share its room. -->
                    <UniformGrid x:Name="ColumnsPanel" Rows="1" Margin="0,0,-10,0" Visibility="Collapsed">
                        <DockPanel x:Name="ColumnInfo" Margin="0,0,10,0">
                            <Border DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}" BorderBrush="{DynamicResource InfoBrush}">
                                <DockPanel>
                                    <TextBlock x:Name="ColumnInfoCount" DockPanel.Dock="Right" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                                    <TextBlock Text="INFO" Style="{StaticResource TileLabel}" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <ScrollViewer x:Name="ColumnInfoScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ColumnInfoItems" ItemTemplate="{StaticResource CompactCard}"/>
                                </ScrollViewer>
                                <TextBlock x:Name="ColumnInfoEmpty" Text="Nothing here." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                        <DockPanel x:Name="ColumnOK" Margin="0,0,10,0">
                            <Border DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}" BorderBrush="{DynamicResource OkBrush}">
                                <DockPanel>
                                    <TextBlock x:Name="ColumnOKCount" DockPanel.Dock="Right" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OkBrush}"/>
                                    <TextBlock Text="OK" Style="{StaticResource TileLabel}" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <ScrollViewer x:Name="ColumnOKScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ColumnOKItems" ItemTemplate="{StaticResource CompactCard}"/>
                                </ScrollViewer>
                                <TextBlock x:Name="ColumnOKEmpty" Text="Nothing here." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                        <DockPanel x:Name="ColumnWarning" Margin="0,0,10,0">
                            <Border DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}" BorderBrush="{DynamicResource WarningBrush}">
                                <DockPanel>
                                    <TextBlock x:Name="ColumnWarningCount" DockPanel.Dock="Right" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="WARNING" Style="{StaticResource TileLabel}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <ScrollViewer x:Name="ColumnWarningScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ColumnWarningItems" ItemTemplate="{StaticResource CompactCard}"/>
                                </ScrollViewer>
                                <TextBlock x:Name="ColumnWarningEmpty" Text="Nothing here." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                        <DockPanel x:Name="ColumnCritical" Margin="0,0,10,0">
                            <Border DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}" BorderBrush="{DynamicResource CriticalBrush}">
                                <DockPanel>
                                    <TextBlock x:Name="ColumnCriticalCount" DockPanel.Dock="Right" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CriticalBrush}"/>
                                    <TextBlock Text="CRITICAL" Style="{StaticResource TileLabel}" Foreground="{DynamicResource CriticalBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <ScrollViewer x:Name="ColumnCriticalScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ColumnCriticalItems" ItemTemplate="{StaticResource CompactCard}"/>
                                </ScrollViewer>
                                <TextBlock x:Name="ColumnCriticalEmpty" Text="Nothing here." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                    </UniformGrid>

                    <TextBlock x:Name="EmptyText" Text="No results yet. Click Run check." Foreground="{DynamicResource MutedBrush}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                    <!-- Timeline page: what happened on the computer lately, one group per day.
                         A red dot is a failure, a blue one a change. -->
                    <DockPanel x:Name="TimelinePanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionCard}" Margin="0,0,6,10">
                            <DockPanel>
                                <ComboBox x:Name="TimelineFilter" DockPanel.Dock="Right" Width="150" VerticalAlignment="Top" SelectedIndex="0" Margin="12,0,0,0">
                                    <ComboBoxItem Content="Everything" Tag=""/>
                                    <ComboBoxItem Content="Problems only" Tag="Problem"/>
                                    <ComboBoxItem Content="Changes only" Tag="Change"/>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock x:Name="TimelineSummary" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Look for a change (an installation, an update, a driver) shortly before the first failure: that is the usual cause." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TimelineItems" Margin="0,0,6,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel Margin="2,0,2,5">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="{Binding Day}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            </DockPanel>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,8">
                                                <ItemsControl ItemsSource="{Binding Events}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="46" Foreground="{DynamicResource MutedBrush}"/>
                                                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{DynamicResource InfoBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="Problem">
                                                                                    <Setter Property="Fill" Value="{DynamicResource CriticalBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Width="220" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="Problem">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Times}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Live monitor page: what the computer is doing right now. It replaces
                         the result cards while the "Live monitor" entry is selected. -->
                    <ScrollViewer x:Name="MonitorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,6,0">

                            <!-- Tool bar: pause, refresh rate, recording to a file -->
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="Record for" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="MonitorRecordMinutes" Width="92" VerticalAlignment="Center" SelectedIndex="1">
                                        <ComboBoxItem Content="1 minute" Tag="1"/>
                                        <ComboBoxItem Content="5 minutes" Tag="5"/>
                                        <ComboBoxItem Content="15 minutes" Tag="15"/>
                                        <ComboBoxItem Content="60 minutes" Tag="60"/>
                                    </ComboBox>
                                    <Button x:Name="MonitorRecordButton" Content="Record to file" Tag="&#xE7C8;" ToolTip="Write every measurement to a CSV file, for example while the problem is reproduced" Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="MonitorPauseButton" Content="Pause" Tag="&#xE769;" Style="{StaticResource SmallButton}"/>
                                    <TextBlock Text="Refresh every" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <ComboBox x:Name="MonitorIntervalBox" Width="104" VerticalAlignment="Center" SelectedIndex="0">
                                        <ComboBoxItem Content="2 seconds" Tag="2"/>
                                        <ComboBoxItem Content="5 seconds" Tag="5"/>
                                        <ComboBoxItem Content="10 seconds" Tag="10"/>
                                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="MonitorRecordText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,-4,0,10" Visibility="Collapsed"/>

                            <!-- Warnings about a value that has stayed high for a while -->
                            <ItemsControl x:Name="MonitorAlerts">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WarningBackBrush}" BorderBrush="{DynamicResource WarningDotBrush}" BorderThickness="4,0,0,0" CornerRadius="6" Padding="14,9" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The most important numbers at a glance -->
                            <UniformGrid Columns="5" Margin="0,0,-10,10">
                                <Border x:Name="MonitorCpuTile" Style="{StaticResource MonitorTileLink}" ToolTip="Click to see everything about the processor">
                                    <StackPanel>
                                        <DockPanel>
                                            <ToggleButton x:Name="MonitorCpuAdviceButton" DockPanel.Dock="Right" Style="{StaticResource WarningToggle}" ToolTip="What to do about it" Visibility="Collapsed" Margin="4,-4,-6,-4"/>
                                            <Ellipse x:Name="MonitorCpuDot" DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource NeutralBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="PROCESSOR" Style="{StaticResource TileLabel}"/>
                                        </DockPanel>
                                        <TextBlock x:Name="MonitorTileCpu" Text="-" Style="{StaticResource MonitorTileValue}" Foreground="{DynamicResource CpuBrush}"/>
                                        <TextBlock x:Name="MonitorTileCpuSub" Style="{StaticResource MonitorTileSub}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MonitorMemoryTile" Style="{StaticResource MonitorTileLink}" ToolTip="Click to see everything about the memory">
                                    <StackPanel>
                                        <DockPanel>
                                            <ToggleButton x:Name="MonitorMemoryAdviceButton" DockPanel.Dock="Right" Style="{StaticResource WarningToggle}" ToolTip="What to do about it" Visibility="Collapsed" Margin="4,-4,-6,-4"/>
                                            <Ellipse x:Name="MonitorMemoryDot" DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource NeutralBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="MEMORY" Style="{StaticResource TileLabel}"/>
                                        </DockPanel>
                                        <TextBlock x:Name="MonitorTileMemory" Text="-" Style="{StaticResource MonitorTileValue}" Foreground="{DynamicResource MemoryBrush}"/>
                                        <TextBlock x:Name="MonitorTileMemorySub" Style="{StaticResource MonitorTileSub}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MonitorGpuTile" Style="{StaticResource MonitorTileLink}" ToolTip="Click to see everything about the graphics card">
                                    <StackPanel>
                                        <DockPanel>
                                            <ToggleButton x:Name="MonitorGpuAdviceButton" DockPanel.Dock="Right" Style="{StaticResource WarningToggle}" ToolTip="What to do about it" Visibility="Collapsed" Margin="4,-4,-6,-4"/>
                                            <Ellipse x:Name="MonitorGpuDot" DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource NeutralBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="GRAPHICS" Style="{StaticResource TileLabel}"/>
                                        </DockPanel>
                                        <TextBlock x:Name="MonitorTileGpu" Text="-" Style="{StaticResource MonitorTileValue}" Foreground="{DynamicResource GpuBrush}"/>
                                        <TextBlock x:Name="MonitorTileGpuSub" Style="{StaticResource MonitorTileSub}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MonitorLatencyTile" Style="{StaticResource MonitorTile}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse x:Name="MonitorLatencyDot" DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource NeutralBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="INTERNET" Style="{StaticResource TileLabel}"/>
                                        </DockPanel>
                                        <TextBlock x:Name="MonitorTileLatency" Text="-" Style="{StaticResource MonitorTileValue}" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="MonitorTileLatencySub" Style="{StaticResource MonitorTileSub}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MonitorTile}">
                                    <StackPanel>
                                        <TextBlock Text="RUNNING FOR" Style="{StaticResource TileLabel}"/>
                                        <TextBlock x:Name="MonitorTileUptime" Text="-" Style="{StaticResource MonitorTileValue}" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="MonitorTileUptimeSub" Style="{StaticResource MonitorTileSub}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- What to do about a value that is above its limit. Opened with the
                                 triangle on the tile of that value. -->
                            <Border x:Name="MonitorAdviceCard" Background="{DynamicResource CriticalBackBrush}" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="4,0,0,0" CornerRadius="6" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="MonitorAdviceTitle" FontWeight="SemiBold" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="MonitorAdviceItems" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Ellipse DockPanel.Dock="Left" Width="4" Height="4" Fill="{DynamicResource TextBrush}" VerticalAlignment="Top" Margin="2,7,8,0"/>
                                                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="MonitorAdviceAction" Content="Open Task Manager" Tag="&#xE8A7;" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Processor: history, details, then one meter per logical processor -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="MonitorCpuText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Processor" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource GraphFrame}">
                                        <Grid>
                                            <Canvas x:Name="MonitorCpuGraph" ClipToBounds="True">
                                                <Polygon x:Name="MonitorCpuArea" Fill="{DynamicResource CpuBrush}" Opacity="0.16"/>
                                                <Polyline x:Name="MonitorCpuLine" Stroke="{DynamicResource CpuBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <TextBlock Text="last 60 measurements, 0 - 100 %" Style="{StaticResource GraphCaption}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="MonitorCpuDetail" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="MonitorProcessors">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,14,10" ToolTip="{Binding Tip}" Background="Transparent">
                                                    <DockPanel Margin="0,0,0,3">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}"/>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource MeterBar}" Foreground="{DynamicResource CpuBrush}" Height="6"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Memory: share in use, history and the breakdown -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="MonitorMemoryText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Memory" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="MonitorMemoryBar" Style="{StaticResource MeterBar}" Height="10" Foreground="{DynamicResource MemoryBrush}" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource GraphFrame}">
                                        <Grid>
                                            <Canvas x:Name="MonitorMemoryGraph" ClipToBounds="True">
                                                <Polygon x:Name="MonitorMemoryArea" Fill="{DynamicResource MemoryBrush}" Opacity="0.16"/>
                                                <Polyline x:Name="MonitorMemoryLine" Stroke="{DynamicResource MemoryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <TextBlock Text="last 60 measurements, 0 - 100 %" Style="{StaticResource GraphCaption}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl x:Name="MonitorMemoryStats">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,14,6">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Graphics: history of the first adapter, then one row per adapter -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Graphics" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="MonitorGpuEmpty" Text="No graphics data available." Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                                    <Border x:Name="MonitorGpuGraphFrame" Style="{StaticResource GraphFrame}">
                                        <Grid>
                                            <Canvas x:Name="MonitorGpuGraph" ClipToBounds="True">
                                                <Polygon x:Name="MonitorGpuArea" Fill="{DynamicResource GpuBrush}" Opacity="0.16"/>
                                                <Polyline x:Name="MonitorGpuLine" Stroke="{DynamicResource GpuBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <TextBlock Text="last 60 measurements, 0 - 100 %" Style="{StaticResource GraphCaption}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl x:Name="MonitorGpus">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <DockPanel Margin="0,0,0,3">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource MeterBar}" Foreground="{DynamicResource GpuBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Disks: history of the busiest disk, activity of every physical disk,
                                 then the space on every drive letter -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Disks" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource GraphFrame}">
                                        <Grid>
                                            <Canvas x:Name="MonitorDiskGraph" ClipToBounds="True">
                                                <Polygon x:Name="MonitorDiskArea" Fill="{DynamicResource DiskBrush}" Opacity="0.16"/>
                                                <Polyline x:Name="MonitorDiskLine" Stroke="{DynamicResource DiskBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <TextBlock Text="busiest disk, last 60 measurements, 0 - 100 %" Style="{StaticResource GraphCaption}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl x:Name="MonitorDisks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <DockPanel Margin="0,0,0,3">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource MeterBar}" Foreground="{DynamicResource DiskBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="SPACE USED" Style="{StaticResource TileLabel}" Margin="0,6,0,6"/>
                                    <ItemsControl x:Name="MonitorVolumes">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <DockPanel Margin="0,0,0,3">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                                    </DockPanel>
                                                    <!-- The meter turns orange and red as the drive fills up -->
                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningDotBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                                        <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>

                                                    <!-- What takes up the space: measured when the line is opened -->
                                                    <ToggleButton x:Name="VolumeToggle" Content="{Binding ToggleText}" IsChecked="{Binding Expanded, Mode=OneWay}" Style="{StaticResource LinkToggle}" Margin="0,6,0,0"/>
                                                    <Border Background="{DynamicResource GraphBackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,6,0,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Details}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding State}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Lists}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="LARGEST PROGRAMS" Style="{StaticResource TileLabel}" Margin="0,0,0,5"/>
                                                                    <ItemsControl ItemsSource="{Binding Programs}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <DockPanel Style="{StaticResource ClickableRow}" ToolTip="{Binding Tip}" Margin="0,0,0,3">
                                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                                </DockPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="LARGEST FOLDERS" Style="{StaticResource TileLabel}" Margin="0,0,0,5"/>
                                                                    <ItemsControl ItemsSource="{Binding Folders}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <DockPanel Margin="0,0,0,3">
                                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                                </DockPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Note}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                                <Button x:Name="VolumeAppsButton" Content="Open Installed apps" Tag="&#xE8A7;" ToolTip="The page of Windows where a program is removed" Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                                                                <Button x:Name="VolumeStorageButton" Content="Open Storage settings" Tag="&#xE8A7;" Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                                                                <Button x:Name="VolumeRefreshButton" Content="Measure again" Tag="&#xE72C;" Style="{StaticResource SmallButton}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Network: download and upload of all adapters as two lines, then one row per
                                 adapter and the answer times of the router and of the internet -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Network" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource GraphFrame}">
                                        <Grid>
                                            <Canvas x:Name="MonitorNetworkGraph" ClipToBounds="True">
                                                <Polyline x:Name="MonitorNetworkUpLine" Stroke="{DynamicResource GpuBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                                <Polyline x:Name="MonitorNetworkDownLine" Stroke="{DynamicResource CpuBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <TextBlock x:Name="MonitorNetworkCaption" Style="{StaticResource GraphCaption}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl x:Name="MonitorNetwork">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,5">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Sensors: temperatures, fans, power, drive wear and battery, as far as
                                 Windows and the drivers hand them out -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Sensors" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="MonitorSensors">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,5">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="MonitorNote" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="The temperature of the processor, the fans of the motherboard and voltages are not shown: Windows does not expose them, and tools that show them install their own hardware driver."/>
                                </StackPanel>
                            </Border>

                            <!-- Programs: the ones using the most processor time, the most memory, and reading
                                 and writing the most data (files, network and devices together). A click
                                 on a program shows its details below. -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Text="processor  |  memory" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="Busiest programs" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                            <ItemsControl x:Name="MonitorProcesses">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Style="{StaticResource ClickableRow}" Margin="0,0,0,1">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Text="memory" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="Most memory" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                            <ItemsControl x:Name="MonitorMemoryProcesses">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Style="{StaticResource ClickableRow}" Margin="0,0,0,1">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Text="read + written" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="Most data" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                            <TextBlock x:Name="MonitorIoEmpty" Text="No program is reading or writing." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                            <ItemsControl x:Name="MonitorIoProcesses">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Style="{StaticResource ClickableRow}" Margin="0,0,0,1">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Details of the program that was clicked -->
                                    <Border x:Name="MonitorProgramCard" Background="{DynamicResource GraphBackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="MonitorProgramTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                            <ItemsControl x:Name="MonitorProgramDetails">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" Width="150"/>
                                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="MonitorProgramHint" Text="Click a program to see its details." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Detail page of one component of the Live monitor (processor, memory or
                         graphics card). A click on the tile of the component opens it in place
                         of the monitor; it lists everything that can be read about the component. -->
                    <ScrollViewer x:Name="ComponentPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,6,0">
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="ComponentBackButton" DockPanel.Dock="Left" Content="Back to the Live monitor" Tag="&#xE72B;" ToolTip="Back to the Live monitor (Esc)" Style="{StaticResource SmallButton}"/>
                                <Button x:Name="ComponentRefreshButton" DockPanel.Dock="Right" Content="Read again" Tag="&#xE72C;" Style="{StaticResource SmallButton}"/>
                                <TextBlock x:Name="ComponentState" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0"/>
                            </DockPanel>

                            <!-- The value right now, its status and its history -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="ComponentValue" DockPanel.Dock="Right" Text="-" FontSize="26" FontWeight="Bold" Margin="14,0,0,0"/>
                                        <Ellipse x:Name="ComponentDot" DockPanel.Dock="Left" Width="12" Height="12" Fill="{DynamicResource NeutralBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="ComponentSummary" Foreground="{DynamicResource TextBrush}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource GraphFrame}" Height="150" Margin="0">
                                        <Grid>
                                            <Canvas x:Name="ComponentGraph" ClipToBounds="True">
                                                <Polygon x:Name="ComponentArea" Fill="{DynamicResource CpuBrush}" Opacity="0.16"/>
                                                <Polyline x:Name="ComponentLine" Stroke="{DynamicResource CpuBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <TextBlock Text="last 60 measurements, 0 - 100 %" Style="{StaticResource GraphCaption}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- What to do, while the value is close to its limit or above it -->
                            <Border x:Name="ComponentAdviceCard" Background="{DynamicResource CriticalBackBrush}" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="4,0,0,0" CornerRadius="6" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="ComponentAdviceTitle" FontWeight="SemiBold" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="ComponentAdviceItems" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Ellipse DockPanel.Dock="Left" Width="4" Height="4" Fill="{DynamicResource TextBrush}" VerticalAlignment="Top" Margin="2,7,8,0"/>
                                                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="ComponentAdviceAction" Content="Open Task Manager" Tag="&#xE8A7;" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- The values of the newest measurement, redrawn with every measurement -->
                            <ItemsControl x:Name="ComponentLiveSections" ItemTemplate="{StaticResource DetailSection}"/>

                            <!-- Everything else that can be read, redrawn when it was read again -->
                            <ItemsControl x:Name="ComponentSections" ItemTemplate="{StaticResource DetailSection}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings page -->
                    <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="Language" Width="150" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="Hrvatski" Tag="hr"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="Theme" Width="150" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Same as Windows" Tag="System"/>
                                            <ComboBoxItem Content="Light" Tag="Light"/>
                                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock x:Name="SettingsRestartText" Text="The theme changes at once. The language is applied when the application starts the next time." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <Button x:Name="RestartButton" Content="Restart now" Tag="&#xE72C;" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="When the application starts" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="Administrator rights" Width="150" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="StartupBox" Width="260" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Ask every time" Tag="Ask"/>
                                            <ComboBoxItem Content="Always start as administrator" Tag="Always"/>
                                            <ComboBoxItem Content="Always start with standard rights" Tag="Never"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock Text="The check starts by itself as soon as the application is open. Before Windows gives administrator rights, it always asks for confirmation." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="In the background" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="BackgroundBox" Content="Keep running when the window is closed" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="AutoStartBox" Content="Start with Windows" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Closed, the application stays as an icon next to the clock, repeats the check and announces new problems. A click on the icon opens the window; a right click offers Exit. Started with Windows, it opens there without a window and with standard rights." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Automatic check" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="Repeat the check" Width="150" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="AutoCheckBox" Width="220" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Every 5 minutes" Tag="5"/>
                                            <ComboBoxItem Content="Every 15 minutes" Tag="15"/>
                                            <ComboBoxItem Content="Every 30 minutes" Tag="30"/>
                                            <ComboBoxItem Content="Every 60 minutes" Tag="60"/>
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock Text="After the first check the application repeats it in the background and updates the results. A problem that is new is announced at the top of the window and, while the window is not in front, with a Windows notification. A click on it leads to the result." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="ShortcutItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,5">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="150" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="AboutText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="The application only reads information and never changes anything on the computer. Its own settings, the history of earlier checks and recordings of the Live monitor are kept in the folder below." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,6"/>
                                    <TextBlock x:Name="DataFolderText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Button x:Name="OpenDataFolderButton" Content="Open the folder" Tag="&#xE838;" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- The question at the start: with administrator rights or without? It covers the
         window until it is answered; the check then starts by itself. -->
    <Border x:Name="StartupOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="28,24" MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="Run the check with administrator rights?" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="With administrator rights the check also shows what Windows only tells administrators: BitLocker and TPM, the temperature and wear of the drives, failed sign-ins and restore points. Windows asks you to confirm. Without them the check shows everything a standard user may see." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="The check starts by itself after your answer." Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="StartupYesButton" Content="Yes, as administrator" Tag="&#xEA18;" ToolTip="Key: Enter" Style="{StaticResource AccentButton}" Margin="0,0,10,0"/>
                    <Button x:Name="StartupNoButton" Content="No, standard rights" ToolTip="Key: Esc" Style="{StaticResource ActionButton}"/>
                </StackPanel>
                <CheckBox x:Name="StartupRememberBox" Content="Remember my answer and do not ask again" Foreground="{DynamicResource TextBrush}" Margin="0,18,0,0"/>
                <TextBlock Text="The answer can be changed on the Settings page." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="20,3,0,0"/>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
