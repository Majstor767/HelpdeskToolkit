<!--
    Layout of the HelpdeskToolkit window. It only describes how the window looks;
    what the buttons do is wired up in Show-PCHealthCheck. Controls that the code
    needs carry an x:Name.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpdeskToolkit - PC Health Check"
        Width="1100" Height="860" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Same colors as the HTML report. -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#14233A"/>
        <SolidColorBrush x:Key="HeaderMutedBrush" Color="#B3C0D3"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE3EA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#18212F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5A6677"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2B5EA8"/>
        <SolidColorBrush x:Key="OkBrush" Color="#1B7A48"/>
        <SolidColorBrush x:Key="OkBackBrush" Color="#E4F4EA"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00"/>
        <SolidColorBrush x:Key="WarningBackBrush" Color="#FFF3D1"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="#B3261E"/>
        <SolidColorBrush x:Key="CriticalBackBrush" Color="#FDE7E5"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#2B5EA8"/>
        <SolidColorBrush x:Key="InfoBackBrush" Color="#E7EFFA"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#B8C2CF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,7"/>
        </Style>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,4,1,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="TileCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,8,3"/>
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header: title on the left, options and the Run button on the right -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="HELPDESKTOOLKIT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderMutedBrush}"/>
                    <TextBlock Text="PC Health Check" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="ComputerText" Foreground="{StaticResource HeaderMutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="SkipNetworkCheckBox" Content="Skip network tests" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="Event log period" Foreground="{StaticResource HeaderMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DaysComboBox" Width="92" VerticalAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="7 days" Tag="7"/>
                        <ComboBoxItem Content="14 days" Tag="14"/>
                        <ComboBoxItem Content="30 days" Tag="30"/>
                        <ComboBoxItem Content="90 days" Tag="90"/>
                    </ComboBox>
                    <Button x:Name="RunButton" Content="Run check" Style="{StaticResource PrimaryButton}" Margin="18,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,7">
            <DockPanel>
                <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Right" Width="200" Height="10" Minimum="0" Maximum="100" Visibility="Hidden"/>
                <TextBlock x:Name="StatusText" Text="Ready. Click Run check to examine this computer." Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Overall verdict, shown after a run -->
            <Border x:Name="VerdictBorder" Grid.Row="0" CornerRadius="6" Padding="14,9" Margin="0,0,0,12" BorderThickness="4,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="VerdictText" FontSize="14" TextWrapping="Wrap"/>
            </Border>

            <!-- Count per status -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-10,12">
                <Border Style="{StaticResource Tile}" BorderBrush="{StaticResource CriticalBrush}">
                    <StackPanel>
                        <TextBlock x:Name="CriticalCount" Text="-" Style="{StaticResource TileCount}" Foreground="{StaticResource CriticalBrush}"/>
                        <TextBlock Text="CRITICAL" Style="{StaticResource TileLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" BorderBrush="{StaticResource WarningBrush}">
                    <StackPanel>
                        <TextBlock x:Name="WarningCount" Text="-" Style="{StaticResource TileCount}" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="WARNING" Style="{StaticResource TileLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" BorderBrush="{StaticResource OkBrush}">
                    <StackPanel>
                        <TextBlock x:Name="OkCount" Text="-" Style="{StaticResource TileCount}" Foreground="{StaticResource OkBrush}"/>
                        <TextBlock Text="OK" Style="{StaticResource TileLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" BorderBrush="{StaticResource InfoBrush}">
                    <StackPanel>
                        <TextBlock x:Name="InfoCount" Text="-" Style="{StaticResource TileCount}" Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="INFO" Style="{StaticResource TileLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Filter on the left, report buttons on the right -->
            <DockPanel Grid.Row="2" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenReportButton" Content="Open HTML report" Style="{StaticResource ActionButton}" IsEnabled="False"/>
                    <Button x:Name="SaveAsButton" Content="Save as..." Style="{StaticResource ActionButton}" IsEnabled="False"/>
                </StackPanel>
                <CheckBox x:Name="ProblemsOnlyCheckBox" Content="Show problems only" VerticalAlignment="Center" IsEnabled="False"/>
            </DockPanel>

            <!-- Results -->
            <Grid Grid.Row="3">
                <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                          RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="9,1" Margin="10,6" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource InfoBackBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                                        <Setter Property="Background" Value="{StaticResource OkBackBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                        <Setter Property="Background" Value="{StaticResource WarningBackBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                        <Setter Property="Background" Value="{StaticResource CriticalBackBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="10,7"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="270">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="10,7"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Result" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="10,7"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="No results yet. Click Run check." Foreground="{StaticResource MutedBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- Details of the selected check -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,10,0,0" Height="176">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="Select a row to see what the check means." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailDescription" Style="{StaticResource DetailValue}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="DetailResultLabel" Grid.Row="0" Grid.Column="0" Text="Result" Style="{StaticResource DetailLabel}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailResult" Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailAllowedLabel" Grid.Row="1" Grid.Column="0" Text="Allowed" Style="{StaticResource DetailLabel}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailAllowed" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailTypicalLabel" Grid.Row="2" Grid.Column="0" Text="Typical" Style="{StaticResource DetailLabel}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailTypical" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailMoreLabel" Grid.Row="3" Grid.Column="0" Text="More" Style="{StaticResource DetailLabel}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailMore" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailRecommendationLabel" Grid.Row="4" Grid.Column="0" Text="Recommendation" Style="{StaticResource DetailLabel}" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailRecommendation" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
