@{
    # Colors of the dark theme, by the name of the brush in Assets\MainWindow.xaml.
    # New-HealthCheckWindow puts them in place of the light colors written there when the
    # dark theme is chosen. A brush that is not listed keeps its color in both themes.

    WindowBrush        = '#0F141B'
    HeaderBrush        = '#0A0F17'
    HeaderMutedBrush   = '#8FA0B8'
    SurfaceBrush       = '#1A212B'
    BorderBrush        = '#2C3644'
    TextBrush          = '#E6EBF2'
    MutedBrush         = '#9AA7B8'
    NeutralBrush       = '#4A5666'

    # Status colors: brighter on a dark background, with dark fills behind them
    OkBrush            = '#4CC38A'
    OkBackBrush        = '#173323'
    WarningBrush       = '#F0B429'
    WarningBackBrush   = '#3A2E10'
    WarningDotBrush    = '#F0B429'
    CriticalBrush      = '#FF6B61'
    CriticalBackBrush  = '#3D1A18'
    InfoBrush          = '#6FA8FF'
    InfoBackBrush      = '#172A45'

    # Controls
    HoverBrush         = '#232C38'
    SelectedBrush      = '#22344F'
    ControlBorderBrush = '#3A4656'
    TrackBrush         = '#2A3340'
    ScrollThumbBrush   = '#3A4656'
    AccentBrush        = '#3B7DDD'
    AccentHoverBrush   = '#5290EA'
    AccentPressedBrush = '#2B67C0'

    # Live monitor
    CpuBrush           = '#6FA8FF'
    MemoryBrush        = '#B48CFF'
    GpuBrush           = '#3FD0BA'
    DiskBrush          = '#F0A04B'
    GraphBackBrush     = '#141A22'
    GraphCaptionBrush  = '#6F7C8E'
}
